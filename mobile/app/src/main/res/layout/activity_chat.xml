<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/background" android:orientation="vertical">
    <LinearLayout android:layout_width="match_parent" android:layout_height="56dp" android:background="@color/panel_bg" android:gravity="center_vertical" android:orientation="horizontal" android:paddingHorizontal="16dp">
        <TextView android:id="@+id/btnBack" android:layout_width="42dp" android:layout_height="42dp" android:gravity="center" android:text="&lt;" android:textColor="@color/surface_white" android:textSize="24sp" android:textStyle="bold" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Chats" android:textColor="@color/surface_white" android:textSize="19sp" android:textStyle="bold" />
    </LinearLayout>
    <EditText android:id="@+id/etSearch" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_margin="16dp" android:background="@drawable/bg_search_field" android:hint="Search users" android:padding="14dp" />
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/searchResults" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginHorizontal="16dp" android:visibility="gone" />
    <ProgressBar android:id="@+id/progressBar" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="4dp" android:indeterminate="true" android:indeterminateTint="@color/primary_green" android:visibility="gone" />
    <TextView android:id="@+id/tvEmpty" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:paddingVertical="48dp" android:text="No conversations yet." android:textColor="@color/text_hint" android:visibility="gone" />
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/recyclerView" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:clipToPadding="false" android:padding="16dp" />
</LinearLayout>
