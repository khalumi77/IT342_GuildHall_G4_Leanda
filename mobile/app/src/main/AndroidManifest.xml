<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.GuildHall"
        android:networkSecurityConfig="@xml/network_security_config">

        <!-- Login — launcher entry point -->
        <activity
            android:name=".auth.LoginActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Register -->
        <activity
            android:name=".auth.RegisterActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!--
            GoogleAuthCallbackActivity — catches the deep link redirect from the backend
            after the server-side Google OAuth2 flow completes.
            Deep link: guildhall://auth/google/success?token=...&newUser=...
        -->
        <activity
            android:name=".auth.GoogleAuthCallbackActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="guildhall"
                    android:host="auth"
                    android:pathPrefix="/google/success" />
            </intent-filter>
        </activity>

        <!-- Skills selection -->
        <activity
            android:name=".skills.SkillsActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- My Guilds list -->
        <activity
            android:name=".guild.GuildsActivity"
            android:exported="false" />

        <!-- Browse all guilds -->
        <activity
            android:name=".guild.BrowseGuildsActivity"
            android:exported="false" />

        <activity
            android:name=".guild.GuildDashboardActivity"
            android:exported="false" />

        <activity
            android:name=".quest.CommissionedQuestsActivity"
            android:exported="false" />

        <activity
            android:name=".quest.AcceptedQuestsActivity"
            android:exported="false" />

        <activity
            android:name=".quest.ImageViewerActivity"
            android:exported="false" />

        <activity
            android:name=".profile.ProfileActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".chat.ChatActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".chat.ConversationActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".admin.AdminDashboardActivity"
            android:exported="false" />

        <!-- Welcome placeholder -->
        <activity
            android:name=".WelcomeActivity"
            android:exported="false" />

        <activity
            android:name=".MainActivity"
            android:exported="false" />

    </application>

</manifest>
