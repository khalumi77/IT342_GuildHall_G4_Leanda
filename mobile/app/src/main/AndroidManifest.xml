<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.GuildHall"
        android:networkSecurityConfig="@xml/network_security_config">

        <!-- Login — launcher entry point -->
        <activity
            android:name=".auth.LoginActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Register -->
        <activity
            android:name=".auth.RegisterActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!--
            GoogleAuthCallbackActivity — catches the deep link redirect from the backend
            after the server-side Google OAuth2 flow completes.

            The backend redirects to: guildhall://auth/google/success?token=...&newUser=...
            This activity intercepts that URL, extracts the JWT, and navigates accordingly.
        -->
        <activity
            android:name=".auth.GoogleAuthCallbackActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <!-- Custom scheme deep link: guildhall://auth/google/success -->
                <data
                    android:scheme="guildhall"
                    android:host="auth"
                    android:pathPrefix="/google/success" />
            </intent-filter>
        </activity>

        <!-- Skills selection — shown after first-time Google or email registration -->
        <activity
            android:name=".skills.SkillsActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Guilds list -->
        <activity
            android:name=".guild.GuildsActivity"
            android:exported="false" />

        <!-- Welcome placeholder (kept for now) -->
        <activity
            android:name=".WelcomeActivity"
            android:exported="false" />

        <!-- Main stub that redirects to GuildsActivity -->
        <activity
            android:name=".MainActivity"
            android:exported="false" />

    </application>

</manifest>